<?xml version="1.0" encoding="utf-8"?>
<!-- .NET Framework settings for LangitSwarm.exe (the app window runs on .NET via pywebview).
     Must sit next to LangitSwarm.exe. -->
<configuration>
  <runtime>
    <!-- an error in the window thread must not end the program: the launcher then
         opens Langit Swarm in the web browser instead -->
    <legacyUnhandledExceptionPolicy enabled="1" />
    <!-- allow the window's libraries from a folder unzipped from a download -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
